# Copy to secrets.toml and fill in. secrets.toml is gitignored.
#
# Streamlit reads this automatically, so the credentials never go into your
# shell history or an environment variable -- which matters, because a password
# typed after `export` is stored in plain text in ~/.zsh_history and shows up
# in `ps` output while the command runs.
#
# On Streamlit Community Cloud, paste the same keys into the app's Secrets box
# instead of committing this file.

DEADLOCK_SERVER = "http://localhost:8000"
DEADLOCK_SERVER_EMAIL = "you@example.com"
DEADLOCK_SERVER_PASSWORD = ""
